<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="view.MainBoardController"
            prefWidth="1200" prefHeight="800">

    <!-- Haupt-Spielbrett in der Mitte -->
    <center>
        <Pane fx:id="boardView" prefWidth="800" prefHeight="700"
              style="-fx-background-color: #f4e4c1;"/>
    </center>

    <!-- HUD auf der rechten Seite -->
    <right>
        <fx:include source="HUD.fxml" fx:id="hud"/>
    </right>

    <!-- Würfelbereich unten -->
    <bottom>
        <HBox alignment="CENTER" spacing="20">
            <padding><Insets top="10" bottom="10"/></padding>
            <Button fx:id="rollButton" text="🎲 Würfeln" onAction="#onRollDice"
                    style="-fx-font-size: 18; -fx-padding: 10 30;"/>
            <Label fx:id="diceLabel" text="-" style="-fx-font-size: 24;"/>
        </HBox>
    </bottom>
</BorderPane>
