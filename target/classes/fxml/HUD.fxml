<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="view.HUDController"
      prefWidth="300" spacing="8"
      style="-fx-background-color: #2b2b2b; -fx-text-fill: white;">

    <padding><Insets top="15" bottom="15" left="15" right="15"/></padding>

    <Label text="Spielerstand" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>
    <VBox fx:id="playerStatsContainer" spacing="6" style="-fx-text-fill: white;"/>

    <Label fx:id="eventMessageLabel" visible="false"
           style="-fx-text-fill: gold; -fx-font-size: 14; -fx-font-style: italic;"/>
</VBox>
